# ============================================================
# NEXORA PLANNING — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

# ── Ambiente ──────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=dev
SPRING_PROFILES_ACTIVE=dev

# ── Usuário admin inicial (criado pelo DevInitializer no profile dev) ─────────
APP_DEV_USERNAME=admin
APP_DEV_PASSWORD=troque_esta_senha_em_producao
APP_DEV_ROLE=ROLE_TI

# ── Banco de dados PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_db
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere uma chave segura: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ── Azure AD / Microsoft Graph (opcional — somente no profile prod) ──────────
AZURE_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOGGING_LEVEL=INFO
SHOW_SQL=false
